{
  "name": "kaj",
  "version": "0.0.0",
  "private": true,
  "description": "Bangla-first local work and service marketplace for Rajshahi",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24.18.0 <25",
    "pnpm": ">=10.34.5 <11"
  },
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "build": "corepack pnpm --recursive --if-present run build",
    "dev": "node --env-file=.env.example --env-file-if-exists=.env tools/run-workspace-script.mjs dev",
    "format": "prettier --write README.md CONTRIBUTING.md SECURITY.md package.json pnpm-lock.yaml pnpm-workspace.yaml backend infrastructure packages test tools",
    "lint": "prettier --check README.md CONTRIBUTING.md SECURITY.md package.json pnpm-lock.yaml pnpm-workspace.yaml backend infrastructure packages test tools && corepack pnpm --recursive --if-present run lint",
    "migrate": "node --env-file=.env.example --env-file-if-exists=.env tools/run-workspace-script.mjs migrate",
    "migrate:reset": "node --env-file=.env.example --env-file-if-exists=.env tools/run-workspace-script.mjs migrate:reset",
    "seed": "node --env-file=.env.example --env-file-if-exists=.env tools/run-workspace-script.mjs seed",
    "test": "node --test test/*.test.mjs && corepack pnpm --recursive --if-present run test",
    "typecheck": "corepack pnpm --recursive --if-present run typecheck",
    "audit:prod": "corepack pnpm audit --prod"
  },
  "devDependencies": {
    "prettier": "3.9.6",
    "typescript": "5.9.3"
  },
  "pnpm": {
    "ignoredBuiltDependencies": [
      "@scarf/scarf"
    ],
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "prisma"
    ],
    "overrides": {
      "body-parser": "1.20.6",
      "js-yaml": "4.3.1",
      "lodash": "4.18.0",
      "multer": "2.2.0",
      "qs": "6.15.2"
    },
    "auditConfig": {
      "ignoreCves": [
        "CVE-2026-35515",
        "CVE-2026-31808",
        "CVE-2026-32630",
        "CVE-2026-40345"
      ]
    }
  }
}
