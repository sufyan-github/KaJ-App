// Cloudflare deploy for the KAAJ landing page (static assets only).
// Deploy: pnpm run deploy:cloudflare  (runs the build, then `wrangler deploy`)
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "kaaj-landing-page",
  "compatibility_date": "2026-10-20",
  "assets": {
    "directory": "./dist/client",
    "not_found_handling": "single-page-application"
  },
  "routes": [{ "pattern": "kaajapp.abusufyan.online", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false
}
