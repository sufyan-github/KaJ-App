<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Production: TLS only, system trust store only. User-installed CAs are
         excluded so a device-level proxy cannot read NID or selfie uploads. -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
