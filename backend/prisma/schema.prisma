model TrainingCourse {
  id                 String                @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  slug               String                @unique
  skill_id           String?               @db.Uuid
  title_en           String
  title_bn           String
  summary_en         String
  summary_bn         String
  minutes            Int
  est_data_mb        Int
  pass_mark_pct      Int                   @default(70)
  question_count     Int                   @default(10)
  is_safety_critical Boolean               @default(false)
  is_published       Boolean               @default(false)
  version            Int                   @default(1)
  sort_order         Int                   @default(0)
  jobs               Job[]
  created_at         DateTime              @default(now())
  updated_at         DateTime              @updatedAt
  skill              Skill?                @relation(fields: [skill_id], references: [id], onDelete: SetNull)
  lessons            TrainingLesson[]
  questions          TrainingQuestion[]
  attempts           TrainingAttempt[]
  certificates       TrainingCertificate[]

  @@index([skill_id, is_published])
  @@map("training_courses")
}

model TrainingLesson {
  id               String               @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  course_id        String               @db.Uuid
  sort_order       Int
  title_en         String
  title_bn         String
  summary_en       String
  summary_bn       String
  youtube_video_id String?
  duration_s       Int?
  is_safety        Boolean              @default(false)
  course           TrainingCourse       @relation(fields: [course_id], references: [id], onDelete: Cascade)
  opens            TrainingLessonOpen[]

  @@unique([course_id, sort_order])
  @@map("training_lessons")
}

model TrainingQuestion {
  id                String         @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  course_id         String         @db.Uuid
  prompt_en         String
  prompt_bn         String
  options_json      Json
  correct_option_id String
  explanation_en    String
  explanation_bn    String
  is_active         Boolean        @default(true)
  course            TrainingCourse @relation(fields: [course_id], references: [id], onDelete: Cascade)

  @@index([course_id, is_active])
  @@map("training_questions")
}

// Private progress only: opening a lesson never earns anything.
model TrainingLessonOpen {
  user_id         String         @db.Uuid
  lesson_id       String         @db.Uuid
  first_opened_at DateTime       @default(now())
  last_opened_at  DateTime       @default(now())
  user            User           @relation(fields: [user_id], references: [id], onDelete: Cascade)
  lesson          TrainingLesson @relation(fields: [lesson_id], references: [id], onDelete: Cascade)

  @@id([user_id, lesson_id])
  @@index([lesson_id])
  @@map("training_lesson_opens")
}

model TrainingAttempt {
  id             String               @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  user_id        String               @db.Uuid
  course_id      String               @db.Uuid
  course_version Int
  question_ids   Json
  answers_json   Json?
  score_pct      Int?
  passed         Boolean?
  started_at     DateTime             @default(now())
  expires_at     DateTime
  submitted_at   DateTime?
  user           User                 @relation(fields: [user_id], references: [id], onDelete: Cascade)
  course         TrainingCourse       @relation(fields: [course_id], references: [id], onDelete: Cascade)
  certificate    TrainingCertificate?

  @@index([user_id, course_id, started_at])
  @@index([course_id])
  @@map("training_attempts")
}

model TrainingCertificate {
  /// A completion record. Exactly one source: a passed quiz (attempt_id,
  /// course_id, course_version, score_pct) or a mentor-checked learning
  /// enrolment (assignment_id, issued_by_user_id, PRACTICAL_CHECKED).
  id                String           @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  user_id           String           @db.Uuid
  course_id         String?          @db.Uuid
  attempt_id        String?          @unique @db.Uuid
  course_version    Int?
  assignment_id     String?          @unique @db.Uuid
  issued_by_user_id String?          @db.Uuid
  skill_id          String?          @db.Uuid
  /// What was completed, for practical records (the opportunity's title).
  title             String?
  evidence_level    EvidenceLevel
  score_pct         Int?
  public_code       String           @unique
  issued_at         DateTime         @default(now())
  revoked_at        DateTime?
  revoked_reason    String?
  user              User             @relation(fields: [user_id], references: [id], onDelete: Cascade)
  course            TrainingCourse?  @relation(fields: [course_id], references: [id], onDelete: Restrict)
  attempt           TrainingAttempt? @relation(fields: [attempt_id], references: [id], onDelete: Cascade)
  assignment        Assignment?      @relation(fields: [assignment_id], references: [id], onDelete: Restrict)
  issued_by         User?            @relation("CertificateIssuer", fields: [issued_by_user_id], references: [id], onDelete: SetNull)
  skill             Skill?           @relation(fields: [skill_id], references: [id], onDelete: SetNull)

  @@index([user_id, revoked_at])
  @@index([course_id])
  @@index([issued_by_user_id])
  @@index([skill_id])
  @@map("training_certificates")
}

/// One taught session of a learning enrolment (P1.3): the mentor records it,
/// the learner confirms they attended. Progress = these rows.
model LearningSession {
  id                   String     @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  assignment_id        String     @db.Uuid
  held_at              DateTime
  minutes              Int
  topic                String
  notes                String?
  recorded_by_user_id  String     @db.Uuid
  learner_confirmed_at DateTime?
  created_at           DateTime   @default(now())
  assignment           Assignment @relation(fields: [assignment_id], references: [id], onDelete: Cascade)
  recorded_by          User       @relation("LearningSessionRecorder", fields: [recorded_by_user_id], references: [id], onDelete: Restrict)

  @@index([assignment_id, held_at])
  @@index([recorded_by_user_id])
  @@map("learning_sessions")
}
