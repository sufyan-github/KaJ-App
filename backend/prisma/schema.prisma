model Document {
  id                 String                 @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  user_id            String                 @db.Uuid
  kind               String
  storage_key        String                 @unique
  mime               String
  size_bytes         BigInt
  is_sensitive       Boolean                @default(true)
  created_at         DateTime               @default(now())
  deleted_at         DateTime?
  user               User                   @relation(fields: [user_id], references: [id], onDelete: Restrict)
  verification_links VerificationDocument[]
  dispute_evidence   DisputeEvidence[]
  portfolio_item     PortfolioItem?

  @@index([user_id, kind])
  @@map("documents")
}

model PortfolioItem {
  id          String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  user_id     String   @db.Uuid
  document_id String   @unique @db.Uuid
  category_id String   @db.Uuid
  caption     String?
  sort_order  Int      @default(0)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
  user        User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  document    Document @relation(fields: [document_id], references: [id], onDelete: Restrict)
  category    Category @relation(fields: [category_id], references: [id], onDelete: Restrict)

  @@index([user_id, sort_order, created_at])
  @@index([category_id])
  @@map("portfolio_items")
}

model VerificationDocument {
  verification_request_id String              @db.Uuid
  document_id             String              @unique @db.Uuid
  linked_at               DateTime            @default(now())
  purge_after             DateTime?
  purged_at               DateTime?
  request                 VerificationRequest @relation(fields: [verification_request_id], references: [id], onDelete: Cascade)
  document                Document            @relation(fields: [document_id], references: [id], onDelete: Restrict)

  @@id([verification_request_id, document_id])
  @@index([purge_after, purged_at])
  @@map("verification_documents")
}

model Dispute {
  id                String            @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  job_id            String            @db.Uuid
  assignment_id     String            @db.Uuid
  opened_by_user_id String            @db.Uuid
  reason_code       String
  description       String
  status            DisputeStatus     @default(OPEN)
  resolution        String?
  resolved_by       String?           @db.Uuid
  resolved_at       DateTime?
  refund_poisha     BigInt?
  release_poisha    BigInt?
  decision          DisputeDecision?
  evidence_due_at   DateTime
  first_response_at DateTime?
  resolution_due_at DateTime
  created_at        DateTime          @default(now())
  updated_at        DateTime          @updatedAt
  job               Job               @relation(fields: [job_id], references: [id], onDelete: Restrict)
  assignment        Assignment        @relation(fields: [assignment_id], references: [id], onDelete: Restrict)
  opened_by         User              @relation("DisputeOpener", fields: [opened_by_user_id], references: [id], onDelete: Restrict)
  resolver          User?             @relation("DisputeResolver", fields: [resolved_by], references: [id], onDelete: SetNull)
  evidence          DisputeEvidence[]
  appeal            DisputeAppeal?

  @@unique([assignment_id])
  @@index([job_id, status])
  @@index([opened_by_user_id])
  @@index([resolved_by])
  @@map("disputes")
}

model DisputeEvidence {
  id          String    @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  dispute_id  String    @db.Uuid
  user_id     String    @db.Uuid
  kind        String
  storage_key String?
  document_id String?   @db.Uuid
  text        String?
  created_at  DateTime  @default(now())
  dispute     Dispute   @relation(fields: [dispute_id], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [user_id], references: [id], onDelete: Restrict)
  document    Document? @relation(fields: [document_id], references: [id], onDelete: Restrict)

  @@index([dispute_id, created_at])
  @@index([user_id])
  @@index([document_id])
  @@map("dispute_evidence")
}

model DisputeAppeal {
  id                String              @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  dispute_id        String              @unique @db.Uuid
  opened_by_user_id String              @db.Uuid
  reason            String
  status            DisputeAppealStatus @default(PENDING)
  assigned_admin_id String?             @db.Uuid
  resolved_by       String?             @db.Uuid
  resolution        String?
  created_at        DateTime            @default(now())
  resolved_at       DateTime?
  dispute           Dispute             @relation(fields: [dispute_id], references: [id], onDelete: Cascade)
  opened_by         User                @relation("DisputeAppealOpener", fields: [opened_by_user_id], references: [id], onDelete: Restrict)
  assigned_admin    User?               @relation("DisputeAppealAssignee", fields: [assigned_admin_id], references: [id], onDelete: SetNull)
  resolver          User?               @relation("DisputeAppealResolver", fields: [resolved_by], references: [id], onDelete: SetNull)

  @@index([status, created_at])
  @@index([assigned_admin_id])
  @@index([opened_by_user_id])
  @@index([resolved_by])
  @@map("dispute_appeals")
}

model Report {
  id                 String             @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  reporter_user_id   String             @db.Uuid
  subject_user_id    String?            @db.Uuid
  target_type        String
  target_id          String             @db.Uuid
  reason_code        String
  description        String?
  status             ReportStatus       @default(OPEN)
  reviewer_user_id   String?            @db.Uuid
  resolution         String?
  reviewed_at        DateTime?
  /// Safety triage: higher first (0 = normal).
  priority           Int                @default(0) @db.SmallInt
  /// P3.7: when staff first acted on it (review started or decided).
  first_action_at    DateTime?
  created_at         DateTime           @default(now())
  updated_at         DateTime           @updatedAt
  reporter           User               @relation("ReportReporter", fields: [reporter_user_id], references: [id], onDelete: Restrict)
  subject            User?              @relation("ReportSubject", fields: [subject_user_id], references: [id], onDelete: SetNull)
  reviewer           User?              @relation("ReportReviewer", fields: [reviewer_user_id], references: [id], onDelete: SetNull)
  moderation_actions ModerationAction[]

  @@index([target_type, target_id])
  @@index([status, created_at])
  @@index([subject_user_id, status, created_at])
  @@index([reviewer_user_id])
  @@index([reporter_user_id, created_at(sort: Desc)])
  @@index([status, priority, created_at])
  @@map("reports")
}

model ModerationAction {
  id                      String           @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  admin_user_id           String           @db.Uuid
  report_id               String?          @db.Uuid
  target_type             String
  target_id               String           @db.Uuid
  action                  String
  previous_level          ModerationLevel?
  level                   ModerationLevel?
  reason                  String
  expires_at              DateTime?
  requires_reverification Boolean          @default(false)
  review_due_at           DateTime?
  reviewed_at             DateTime?
  created_at              DateTime         @default(now())
  admin                   User             @relation("ModerationAdmin", fields: [admin_user_id], references: [id], onDelete: Restrict)
  report                  Report?          @relation(fields: [report_id], references: [id], onDelete: SetNull)

  @@index([target_type, target_id, created_at(sort: Desc)])
  @@index([admin_user_id])
  @@index([report_id])
  @@index([review_due_at, reviewed_at])
  @@map("moderation_actions")
}

model RiskIdentityObservation {
  id                String           @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  user_id           String           @db.Uuid
  kind              RiskIdentityKind
  value_hash        String
  first_observed_at DateTime         @default(now())
  last_observed_at  DateTime         @default(now())
  occurrences       Int              @default(1)
  user              User             @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, kind, value_hash])
  @@index([kind, value_hash, last_observed_at])
  @@index([user_id, last_observed_at(sort: Desc)])
  @@map("risk_identity_observations")
}

model RiskReviewItem {
  id                String           @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  subject_user_id   String           @db.Uuid
  entity_type       String           @default("USER")
  entity_id         String?          @db.Uuid
  score             Int
  severity          RiskSeverity
  signals_json      Json
  status            RiskReviewStatus @default(OPEN)
  reviewer_user_id  String?          @db.Uuid
  resolution        String?
