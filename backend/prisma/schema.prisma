generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
  PENDING_DELETION
}

enum RoleMode {
  CUSTOMER
  WORKER
  BUSINESS
  /// Granted by an admin approving a mentor application, never self-activated.
  MENTOR
}

/// Mentor application lifecycle on profiles.mentor_status.
enum MentorStatus {
  NONE
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

/// What a jobs row offers. WORK is paid work (the marketplace); the others
/// are learning opportunities published by approved mentors.
enum OpportunityType {
  WORK
  TRAINING
  APPRENTICESHIP
}

/// Money terms of a learning opportunity, for the participant.
enum ParticipantTerms {
  FREE
  PAID_BY_PARTICIPANT
  STIPEND
  UNPAID
}

enum WorkArrangement {
  ON_SITE
  HOME_BASED
  REMOTE
  HYBRID
}

enum TrustLevel {
  NONE
  PHONE
  IDENTITY
  SKILL
  BUSINESS
}

enum JobType {
  ONE_TIME
  HOURLY
  DAILY
  WEEKLY
  RECURRING
  MONTHLY_PART_TIME
  FULL_TIME
  PROJECT
  SERVICE_BOOKING
}

enum PaymentModel {
  FIXED
  HOURLY
  DAILY
  MONTHLY
  NEGOTIABLE
}

enum JobStatus {
  DRAFT
  PUBLISHED
  APPLICATIONS_OPEN
  WORKER_SELECTED
  CONFIRMATION_PENDING
  CONFIRMED
  UPCOMING
  CHECKED_IN
  IN_PROGRESS
  SUBMITTED
  CUSTOMER_REVIEW
  COMPLETED
  PAYMENT_RECORDED
  PAYMENT_RELEASED
  REVIEWED
  EXPIRED
  CANCELLED_BY_CUSTOMER
  CANCELLED_BY_WORKER
  DISPUTED
  SUSPENDED
}

enum ApplicationStatus {
  PENDING
  SHORTLISTED
  WITHDRAWN
  REJECTED
  ACCEPTED
  EXPIRED
}

enum UrgencyLevel {
  FLEXIBLE
  NORMAL
  URGENT
}

enum VerificationStatus {
  NOT_SUBMITTED
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}

enum PaymentStatus {
  NONE
  PENDING
  CASH_RECORDED
  DISPUTED
  HELD
  RELEASED
  REFUNDED
  PARTIALLY_REFUNDED
  FAILED
}

enum DevicePlatform {
  ANDROID
  IOS
  WEB
  UNKNOWN
}

enum OtpPurpose {
  LOGIN
  PHONE_CHANGE
  ACCOUNT_RECOVERY
}

enum Gender {
  FEMALE
  MALE
  NON_BINARY
  PREFER_NOT_TO_SAY
}

enum SkillLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT
}

enum LocationType {
  CITY
  THANA
  AREA
}

enum AssignmentStatus {
  PENDING_CONFIRMATION
  CONFIRMED
  DECLINED
  CANCELLED
  COMPLETED
}

enum JobOccurrenceStatus {
  SCHEDULED
  ASSIGNED
  CONFIRMED
  UPCOMING
  CHECKED_IN
  IN_PROGRESS
  SUBMITTED
  CUSTOMER_REVIEW
  COMPLETED
  CANCELLED_BY_CUSTOMER
  CANCELLED_BY_WORKER
  DECLINED
}

enum JobActorType {
  POSTER
  WORKER
  ADMIN
  SYSTEM
}

enum WorkVerification {
  CUSTOMER
  SYSTEM
  ADMIN
}

enum PaymentMethod {
  CASH_ON_COMPLETION
  MOBILE_FINANCIAL_SERVICE
  CARD
  BANK_TRANSFER
}

enum OperatorVerificationStatus {
  PENDING
  VERIFIED
  REJECTED
  UNSUPPORTED
}

enum SubscriptionStatus {
  ACTIVE
  INACTIVE
  EXPIRED
  PENDING
  CANCELLED
}

enum SubscriptionPaymentStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
}

enum SubscriptionPaymentMethod {
  OPERATOR_BILLING
  MANUAL_ADMIN
}

enum LedgerAccountType {
  CUSTOMER_WALLET
  WORKER_WALLET
  PLATFORM_FEE
  PLATFORM_ESCROW
  PROVIDER_CLEARING
}

enum LedgerDirection {
  DEBIT
  CREDIT
}

enum FeeScope {
  USER
  TIER
  CATEGORY
  GLOBAL
}

enum PayoutStatus {
  REQUESTED
  PROCESSING
  PAID
  FAILED
  CANCELLED
}

/// What a review is about. Values are added as modules gain reviews.
enum ReviewSubjectType {
  ASSIGNMENT
  LEARNING_ENROLMENT
  SESSION
}

enum ReviewDirection {
  C2W
  W2C
}

enum MessageType {
  TEXT
  IMAGE
  SYSTEM
}

enum NotificationChannel {
  IN_APP
  PUSH
  SMS
  EMAIL
}

/// P2.1: how far a business has come. Only REGISTERED can be verified.
enum BusinessStage {
  IDEA
  INFORMAL
  REGISTERED
}

enum GroupVisibility {
  PUBLIC
  PRIVATE
}

enum GroupMemberRole {
  MEMBER
  MODERATOR
  AMBASSADOR
}

enum GroupMemberStatus {
  PENDING
  ACTIVE
  REMOVED
}

enum ConversationKind {
  DIRECT
  GROUP
}

enum SessionKind {
  CONSULTATION
  GROUP_DISCUSSION
  WORKSHOP
  EVENT
}

enum SessionSubjectType {
  IDEA
  BUSINESS
  GROUP
}

enum SessionMode {
  IN_PERSON
  ONLINE
  IN_APP_CHAT
}

enum SessionPriceModel {
  FREE
  CASH
}

enum SessionStatus {
  DRAFT
  SCHEDULED
  CANCELLED
  COMPLETED
}

enum SessionParticipantRole {
  HOST
  EXPERT
  PARTICIPANT
}

enum SessionParticipantStatus {
  INVITED
  ACCEPTED
  DECLINED
  ATTENDED
  NO_SHOW
  /// P3.5: RSVP'd to a full session; promoted in order when a place frees.
  WAITLISTED
}

enum IntroductionContextType {
  IDEA
  BUSINESS
  LEARNING_GOAL
}

enum IntroductionStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
  WITHDRAWN
}

enum IdeaStage {
  CONCEPT
  VALIDATING
  PILOT
  CONVERTED
}

/// PRIVATE: owner, team and approved people only, not searchable.
/// SUMMARY_PUBLIC: the one-line summary is searchable; details as PRIVATE.
/// MEMBERS: team only — approved access is paused, nothing is searchable.
enum IdeaVisibility {
  PRIVATE
  SUMMARY_PUBLIC
  MEMBERS
}

enum IdeaAccessStatus {
  REQUESTED
  APPROVED
  DECLINED
  REVOKED
}

enum IdeaRoleType {
  CO_FOUNDER
  TECHNICAL
  MARKETING
  OPERATIONS
  INDUSTRY_EXPERT
  MENTOR
  SUPPLIER
  DISTRIBUTION
  PRODUCTION
  RESEARCH
}

enum IdeaTimeCommitment {
  FEW_HOURS_A_WEEK
  PART_TIME
  FULL_TIME
  FLEXIBLE
}

enum IdeaArrangement {
  PAID
  EQUITY_TO_DISCUSS
  VOLUNTEER
  UNDECIDED
}

enum IdeaRoleStatus {
  OPEN
  FILLED
  CLOSED
}

enum CollaborationSubjectType {
  IDEA
  BUSINESS
}

enum CollaborationStatus {
  PROPOSED
  ACCEPTED
  DECLINED
  WITHDRAWN
  AGREED
  ENDED
}

enum OfferingKind {
  PRODUCT
  SERVICE
}

enum BusinessMemberRole {
  OWNER
  MANAGER
  STAFF
}

enum VerificationKind {
  PHONE
  IDENTITY
  SKILL
  BUSINESS
  /// A mentor application: skill evidence for the skills they will teach.
  MENTOR
}

enum DisputeStatus {
  OPEN
  EVIDENCE
  UNDER_REVIEW
  RESOLVED
  CLOSED
}

enum DisputeDecision {
  RELEASE_FULL
  RELEASE_PARTIAL
  REFUND_FULL
  REFUND_PARTIAL
  SPLIT
}

enum DisputeAppealStatus {
  PENDING
  RESOLVED
  REJECTED
}

enum ReportStatus {
  OPEN
  UNDER_REVIEW
  ACTIONED
  DISMISSED
}

enum ModerationLevel {
  NONE
  WARN
  RESTRICT
  SUSPEND
  BAN
}

enum RiskIdentityKind {
  DEVICE
  PHONE
  IP
}

enum RiskReviewStatus {
  OPEN
  UNDER_REVIEW
  CLEARED
  ESCALATED
}

enum RiskSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum EvidenceLevel {
  SELF_REPORTED
  KNOWLEDGE_TESTED
  PRACTICAL_CHECKED
  OFFICIALLY_CERTIFIED
}

enum AdminRole {
  ADMIN
  MODERATOR
  SUPPORT
  FINANCE
}

model User {
  id                          String          @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  phone_e164                  String?         @unique
  email                       String?         @unique
  password_hash               String?
  mobile_password_hash        String?
  mobile_auth_version         Int             @default(0)
  status                      UserStatus      @default(ACTIVE)
  role_modes                  RoleMode[]      @default([CUSTOMER])
  active_role                 RoleMode        @default(CUSTOMER)
  is_admin                    Boolean         @default(false)
  default_locale              String          @default("bn")
  timezone                    String          @default("Asia/Dhaka")
  fee_tier                    String?
  last_active_at              DateTime?
  created_at                  DateTime        @default(now())
  updated_at                  DateTime        @updatedAt
  deleted_at                  DateTime?
  moderation_level            ModerationLevel @default(NONE)
  restriction_ends_at         DateTime?
  reverification_required     Boolean         @default(false)
  reverification_requested_at DateTime?
  moderation_reason           String?

  devices                           UserDevice[]
  refresh_tokens                    RefreshToken[]
  profile                           Profile?
  worker_profile                    WorkerProfile?
  customer_profile                  CustomerProfile?
  business_profiles                 BusinessProfile[]
  business_memberships              BusinessMember[]            @relation("BusinessMembership")
  collaboration_sent                CollaborationRequest[]      @relation("CollaborationRequester")
  collaboration_received            CollaborationRequest[]      @relation("CollaborationRecipient")
  collaboration_events              CollaborationRequestEvent[] @relation("CollaborationEventActor")
  ideas                             BusinessIdea[]              @relation("IdeaOwner")
  introductions_sent                IntroductionRequest[]       @relation("IntroductionRequester")
  introductions_received            IntroductionRequest[]       @relation("IntroductionTarget")
  community_groups_created          CommunityGroup[]            @relation("CommunityGroupCreator")
  community_memberships             CommunityGroupMember[]      @relation("CommunityGroupMembership")
  community_invites_sent            CommunityGroupMember[]      @relation("CommunityGroupInviter")
  session_participations            SessionParticipant[]        @relation("SessionParticipation")
  sessions_as_host                  Session[]                   @relation("SessionHost")
  sessions_as_expert                Session[]                   @relation("SessionExpert")
  session_invites_sent              SessionParticipant[]        @relation("SessionInviter")
  session_cash_recorded             SessionParticipant[]        @relation("SessionCashRecorder")
  idea_access                       IdeaAccess[]                @relation("IdeaAccessHolder")
  idea_access_approvals             IdeaAccess[]                @relation("IdeaAccessApprover")
  idea_detail_views                 IdeaDetailView[]            @relation("IdeaDetailViewer")
  idea_memberships                  IdeaMember[]                @relation("IdeaMembership")
  business_member_invites           BusinessMember[]            @relation("BusinessMemberInviter")
  skills                            UserSkill[]
  service_areas                     ServiceArea[]
  posted_jobs                       Job[]                       @relation("JobPoster")
  job_status_changes                JobStatusHistory[]          @relation("JobStatusActor")
  applications                      Application[]
  assignments                       Assignment[]
  availability_rules                AvailabilityRule[]
  availability_exceptions           AvailabilityException[]
  payments                          Payment[]                   @relation("PaymentPayer")
  cash_payments_recorded            Payment[]                   @relation("CashPaymentRecorder")
  payouts                           Payout[]
  wallet                            Wallet?
  reviews_written                   Review[]                    @relation("ReviewWriter")
  reviews_received                  Review[]                    @relation("ReviewSubject")
  conversation_participations       ConversationParticipant[]
  sent_messages                     Message[]
  notifications                     Notification[]
  notification_preferences          NotificationPreference[]
  verification_requests             VerificationRequest[]       @relation("VerificationOwner")
  verification_reviews              VerificationRequest[]       @relation("VerificationReviewer")
  documents                         Document[]
  portfolio_items                   PortfolioItem[]
  community_groups                  CommunityGroup[]
  disputes_opened                   Dispute[]                   @relation("DisputeOpener")
  disputes_resolved                 Dispute[]                   @relation("DisputeResolver")
  dispute_evidence                  DisputeEvidence[]
  dispute_appeals_opened            DisputeAppeal[]             @relation("DisputeAppealOpener")
  dispute_appeals_assigned          DisputeAppeal[]             @relation("DisputeAppealAssignee")
  dispute_appeals_resolved          DisputeAppeal[]             @relation("DisputeAppealResolver")
  overridden_work_sessions          WorkSession[]               @relation("WorkSessionOverrideActor")
  checkout_overridden_work_sessions WorkSession[]               @relation("WorkSessionCheckoutOverrideActor")
  reports_filed                     Report[]                    @relation("ReportReporter")
  reports_received                  Report[]                    @relation("ReportSubject")
  reports_reviewed                  Report[]                    @relation("ReportReviewer")
  moderation_actions                ModerationAction[]          @relation("ModerationAdmin")
  risk_identity_observations        RiskIdentityObservation[]
  risk_items                        RiskReviewItem[]            @relation("RiskSubject")
  risk_items_reviewed               RiskReviewItem[]            @relation("RiskReviewer")
  badges                            UserBadge[]
  saved_searches                    SavedSearch[]
  favorites                         Favorite[]                  @relation("FavoriteOwner")
  favorited_by                      Favorite[]                  @relation("FavoriteTarget")
  users_blocked                     UserBlock[]                 @relation("Blocker")
  blocked_by                        UserBlock[]                 @relation("BlockedUser")
  updated_config_settings           ConfigSetting[]
  audit_logs                        AuditLog[]
  admin_credential                  AdminCredential?
  admin_login_challenges            AdminLoginChallenge[]
  admin_sessions                    AdminSession[]
  config_revisions                  ConfigRevision[]
  notification_campaigns            NotificationCampaign[]
  fee_rules                         FeeRule[]
  idempotency_records               IdempotencyRecord[]
  operator_identity                 UserOperatorIdentity?
  subscriptions                     Subscription[]
  subscription_payments             SubscriptionPayment[]
  training_lesson_opens             TrainingLessonOpen[]
  training_attempts                 TrainingAttempt[]
  training_certificates             TrainingCertificate[]
  recorded_learning_sessions        LearningSession[]           @relation("LearningSessionRecorder")
  issued_certificates               TrainingCertificate[]       @relation("CertificateIssuer")

  @@index([status, deleted_at])
  @@map("users")
}

model AdminCredential {
  user_id                String    @id @db.Uuid
  role                   AdminRole
  totp_secret_ciphertext String
  totp_confirmed_at      DateTime?
  last_totp_counter      BigInt?
  created_at             DateTime  @default(now())
  updated_at             DateTime  @updatedAt
  user                   User      @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([role])
  @@map("admin_credentials")
}

model AdminLoginChallenge {
  id          String    @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  user_id     String    @db.Uuid
  token_hash  String    @unique
  attempts    Int       @default(0)
  expires_at  DateTime
  consumed_at DateTime?
  ip          String?   @db.Inet
  ua          String?
  created_at  DateTime  @default(now())
  user        User      @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, expires_at])
  @@map("admin_login_challenges")
}

model AdminSession {
  id             String    @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  user_id        String    @db.Uuid
  token_hash     String    @unique
  expires_at     DateTime
  last_active_at DateTime  @default(now())
  revoked_at     DateTime?
  ip             String?   @db.Inet
  ua             String?
  created_at     DateTime  @default(now())
  user           User      @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, expires_at])
  @@index([expires_at, revoked_at])
  @@map("admin_sessions")
}

model UserDevice {
  id             String         @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  user_id        String         @db.Uuid
  fcm_token      String?
  platform       DevicePlatform @default(UNKNOWN)
  app_version    String?
  last_seen_at   DateTime       @default(now())
  user           User           @relation(fields: [user_id], references: [id], onDelete: Cascade)
  refresh_tokens RefreshToken[]

  @@index([user_id])
  @@map("user_devices")
}

model RefreshToken {
  id         String     @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  user_id    String     @db.Uuid
  token_hash String     @unique
  device_id  String     @db.Uuid
  family_id  String     @db.Uuid
  expires_at DateTime
  revoked_at DateTime?
  created_at DateTime   @default(now())
  user       User       @relation(fields: [user_id], references: [id], onDelete: Cascade)
  device     UserDevice @relation(fields: [device_id], references: [id], onDelete: Cascade)

  @@index([user_id, family_id])
  @@index([expires_at])
  @@index([device_id])
  @@map("refresh_tokens")
}

model OtpChallenge {
  id                 String     @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  phone_e164         String
  code_hash          String
  purpose            OtpPurpose @default(LOGIN)
  attempts           Int        @default(0)
  expires_at         DateTime
  consumed_at        DateTime?
  recovery_verifying Boolean    @default(false)
  created_at         DateTime   @default(now())

  @@index([phone_e164, purpose, created_at(sort: Desc)])
  @@index([expires_at])
  @@map("otp_challenges")
}

model Profile {
  id                      String            @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  user_id                 String            @unique @db.Uuid
  display_name            String
  photo_key               String?
  bio                     String?
  gender                  Gender?
  birth_year              Int?
  primary_location_id     String?           @db.Uuid
  lat                     Decimal?          @db.Decimal(9, 6)
  lng                     Decimal?          @db.Decimal(9, 6)
  trust_level             TrustLevel        @default(NONE)
  locale                  String            @default("bn")
  /// Privacy (P0.7). Defaults keep the earlier public behaviour: photo
  /// shown, name masked ("Rahima K."), ~500 m point, listed in the directory.
  photo_visibility        PhotoVisibility   @default(EVERYONE)
  show_full_name          Boolean           @default(false)
  hide_precise_area       Boolean           @default(false)
  allow_messages_from     MessagePermission @default(ANYONE)
  discoverable            Boolean           @default(true)
  /// Mentor capability (P1.1). APPROVED + accepting = takes learners.
  mentor_status           MentorStatus      @default(NONE)
  mentor_accepting        Boolean           @default(false)
  mentor_bio              String?
  mentor_years_experience Int?
  mentor_applied_at       DateTime?
  mentor_approved_at      DateTime?
  created_at              DateTime          @default(now())
  updated_at              DateTime          @updatedAt
  deleted_at              DateTime?
  user                    User              @relation(fields: [user_id], references: [id], onDelete: Cascade)
  primary_location        Location?         @relation(fields: [primary_location_id], references: [id], onDelete: SetNull)

  @@index([primary_location_id])
  @@index([mentor_status, mentor_accepting])
  @@map("profiles")
}

/// Who may see a person's profile photo.
enum PhotoVisibility {
  EVERYONE
  /// Only people with a confirmed booking or hire with them.
  AFTER_HIRE
  NOBODY
}

/// Who may start a new conversation with a person.
enum MessagePermission {
  /// Anyone the job flow already allows (an applicant and the poster).
  ANYONE
  /// Only after a hire (an assignment) between the two.
  ENGAGED_ONLY
}

model WorkerProfile {
  id                     String            @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  user_id                String            @unique @db.Uuid
  headline               String?
  service_radius_km      Decimal?          @db.Decimal(6, 2)
  hourly_rate_poisha     BigInt?
  daily_rate_poisha      BigInt?
  monthly_rate_poisha    BigInt?
  experience_years       Int?
  education              String?
  transport_mode         String?
  is_available_now       Boolean           @default(false)
  accepts_urgent         Boolean           @default(false)
  /// P3.7: the worker prefers jobs with flexible hours (feed filter).
  prefers_flexible_hours Boolean           @default(false)
  completed_jobs_count   Int               @default(0)
  rating_avg             Decimal           @default(0) @db.Decimal(3, 2)
  rating_count           Int               @default(0)
  response_rate_bps      Int               @default(0)
  completion_rate_bps    Int               @default(0)
  cancellation_rate_bps  Int               @default(0)
  no_show_count          Int               @default(0)
  reliability_score      Decimal           @default(0) @db.Decimal(5, 4)
  last_active_at         DateTime?
  preferred_arrangements WorkArrangement[] @default([])
  created_at             DateTime          @default(now())
  updated_at             DateTime          @updatedAt
  user                   User              @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([is_available_now, last_active_at])
  @@map("worker_profiles")
}

model CustomerProfile {
  id                      String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  user_id                 String   @unique @db.Uuid
  jobs_posted_count       Int      @default(0)
  rating_avg              Decimal  @default(0) @db.Decimal(3, 2)
  rating_count            Int      @default(0)
  payment_reliability_bps Int      @default(0)
  cancellation_count      Int      @default(0)
  created_at              DateTime @default(now())
  updated_at              DateTime @updatedAt
  user                    User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("customer_profiles")
}

/// P2.1: a business or venture. user_id is the person who created it; who
/// may act for it is business_members. Only a REGISTERED business can be
/// VERIFIED (CHECK business_profiles_verified_stage_check).
model BusinessProfile {
  id                     String                 @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  user_id                String                 @db.Uuid
  business_name          String
  trade_licence_no       String?
  address                String?
  location_id            String?                @db.Uuid
  verification_status    VerificationStatus     @default(NOT_SUBMITTED)
  contact_person         String?
  employees_count        Int?
  stage                  BusinessStage          @default(INFORMAL)
  description            String?
  category_id            String?                @db.Uuid
  is_public              Boolean                @default(false)
  seeking_partners       Boolean                @default(false)
  /// Set by moderation: hidden from everyone but its members.
  suspended_at           DateTime?
  suspension_reason      String?
  deleted_at             DateTime?
  jobs                   Job[]
  created_at             DateTime               @default(now())
  updated_at             DateTime               @updatedAt
  user                   User                   @relation(fields: [user_id], references: [id], onDelete: Cascade)
  location               Location?              @relation(fields: [location_id], references: [id], onDelete: Restrict)
  category               BusinessCategory?      @relation(fields: [category_id], references: [id], onDelete: Restrict)
  members                BusinessMember[]
  verification_requests  VerificationRequest[]
  offerings              BusinessOffering[]
  collaboration_requests CollaborationRequest[]
  converted_from_idea    BusinessIdea?

  @@index([user_id])
  @@index([location_id])
  @@index([category_id])
  @@index([is_public, seeking_partners, category_id, location_id])
  @@map("business_profiles")
}

/// P2.2: a product or service a business offers. At least one title (bn or
/// en); an optional price range in poisha. hidden_at = hidden by moderation.
model BusinessOffering {
  id                  String          @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  business_profile_id String          @db.Uuid
  kind                OfferingKind
  title_en            String?
  title_bn            String?
  description         String?
  price_min_poisha    BigInt?
  price_max_poisha    BigInt?
  /// What the price is for, e.g. "per kg", "per hour".
  price_unit          String?
  is_active           Boolean         @default(true)
  sort_order          Int             @default(0)
  hidden_at           DateTime?
  hidden_reason       String?
  deleted_at          DateTime?
  created_at          DateTime        @default(now())
  updated_at          DateTime        @updatedAt
  business            BusinessProfile @relation(fields: [business_profile_id], references: [id], onDelete: Cascade)

  @@index([business_profile_id, is_active])
  @@map("business_offerings")
}

/// P3.4: a local community group. PUBLIC groups can be found and joined;
/// PRIVATE ones (and every member list) are visible to members only.
/// Women-only groups are opt-in: joining needs a profile marked female and
/// a moderator's approval.
model CommunityGroup {
  id                    String                 @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  created_by_user_id    String                 @db.Uuid
  name                  String
  description           String?
  visibility            GroupVisibility        @default(PUBLIC)
  women_only            Boolean                @default(false)
  location_id           String?                @db.Uuid
  category_id           String?                @db.Uuid
  /// Set by moderation.
  hidden_at             DateTime?
  hidden_reason         String?
  deleted_at            DateTime?
  created_at            DateTime               @default(now())
  updated_at            DateTime               @updatedAt
  created_by            User                   @relation("CommunityGroupCreator", fields: [created_by_user_id], references: [id], onDelete: Cascade)
  location              Location?              @relation(fields: [location_id], references: [id], onDelete: Restrict)
  category              Category?              @relation(fields: [category_id], references: [id], onDelete: Restrict)
  members               CommunityGroupMember[]
  sessions              Session[]
  user                  User?                  @relation(fields: [userId], references: [id])
  userId                String?                @db.Uuid
  introductionRequest   IntroductionRequest?   @relation(fields: [introductionRequestId], references: [id])
  introductionRequestId String?                @db.Uuid

  @@index([visibility, location_id, category_id])
  @@index([created_by_user_id])
  @@index([location_id])
  @@index([category_id])
  @@map("community_groups")
}

model CommunityGroupMember {
  id                 String            @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  group_id           String            @db.Uuid
  user_id            String            @db.Uuid
  role               GroupMemberRole   @default(MEMBER)
  status             GroupMemberStatus @default(PENDING)
  /// Set when a moderator invited them (PENDING until they accept);
  /// null for a join request (PENDING until a moderator approves).
  invited_by_user_id String?           @db.Uuid
  joined_at          DateTime?
  removed_at         DateTime?
  created_at         DateTime          @default(now())
  updated_at         DateTime          @updatedAt
  group              CommunityGroup    @relation(fields: [group_id], references: [id], onDelete: Cascade)
  user               User              @relation("CommunityGroupMembership", fields: [user_id], references: [id], onDelete: Cascade)
  invited_by         User?             @relation("CommunityGroupInviter", fields: [invited_by_user_id], references: [id], onDelete: SetNull)

  @@unique([group_id, user_id])
  @@index([user_id, status])
  @@index([group_id, status, role])
  @@index([invited_by_user_id])
  @@map("community_group_members")
}

/// P3.2: one model for consultations, group discussions, workshops and
/// events (plan migration 13, replacing community_events). In person means
/// an area only; an online link is shown only to accepted participants.
/// Cash sessions are recorded per participant like job cash payments.
model Session {
  id                  String               @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  host_user_id        String               @db.Uuid
  expert_user_id      String?              @db.Uuid
  kind                SessionKind
  title               String
  description         String?
  subject_type        SessionSubjectType?
  subject_id          String?              @db.Uuid
  starts_at           DateTime
  duration_minutes    Int
  mode                SessionMode
  /// IN_PERSON: the area only, never an address or a pin.
  location_id         String?              @db.Uuid
  online_link         String?
  capacity            Int
  price_model         SessionPriceModel    @default(FREE)
  price_poisha        BigInt?
  status              SessionStatus        @default(DRAFT)
  women_only          Boolean              @default(false)
  home_based_friendly Boolean              @default(false)
  /// The accepted introduction a consultation came from, if any.
  introduction_id     String?              @db.Uuid
  /// P3.5: a session of a community group (members only).
  group_id            String?              @db.Uuid
  /// P3.5: the venue pin for check-in. Never returned by the API.
  venue_lat           Decimal?             @db.Decimal(9, 6)
  venue_lng           Decimal?             @db.Decimal(9, 6)
  reminder_sent_at    DateTime?
  cancelled_at        DateTime?
  cancel_reason       String?
  completed_at        DateTime?
  /// Set by moderation.
  hidden_at           DateTime?
  hidden_reason       String?
  created_at          DateTime             @default(now())
  updated_at          DateTime             @updatedAt
  host                User                 @relation("SessionHost", fields: [host_user_id], references: [id], onDelete: Cascade)
  expert              User?                @relation("SessionExpert", fields: [expert_user_id], references: [id], onDelete: SetNull)
  location            Location?            @relation(fields: [location_id], references: [id], onDelete: Restrict)
  introduction        IntroductionRequest? @relation(fields: [introduction_id], references: [id], onDelete: SetNull)
  group               CommunityGroup?      @relation(fields: [group_id], references: [id], onDelete: Cascade)
  participants        SessionParticipant[]

  @@index([host_user_id, starts_at])
  @@index([expert_user_id, starts_at])
  @@index([status, starts_at])
  @@index([subject_type, subject_id])
  @@index([location_id])
  @@index([introduction_id])
  @@index([group_id, starts_at])
  @@map("sessions")
}

model SessionParticipant {
  id                      String                   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  session_id              String                   @db.Uuid
  user_id                 String                   @db.Uuid
  role                    SessionParticipantRole   @default(PARTICIPANT)
  status                  SessionParticipantStatus @default(INVITED)
  invited_by_user_id      String?                  @db.Uuid
  responded_at            DateTime?
  attendance_marked_at    DateTime?
  /// CASH sessions: what the host recorded receiving from this participant.
  cash_amount_poisha      BigInt?
  cash_recorded_at        DateTime?
  cash_recorded_by        String?                  @db.Uuid
  /// P3.5: location check-in (consent and the distance only, no coordinates).
  checked_in_at           DateTime?
  checkin_distance_m      Int?
  checkin_accuracy_m      Decimal?                 @db.Decimal(8, 2)
  checkin_consent_version String?
  waitlisted_at           DateTime?
  created_at              DateTime                 @default(now())
  updated_at              DateTime                 @updatedAt
  session                 Session                  @relation(fields: [session_id], references: [id], onDelete: Cascade)
  user                    User                     @relation("SessionParticipation", fields: [user_id], references: [id], onDelete: Cascade)
  invited_by              User?                    @relation("SessionInviter", fields: [invited_by_user_id], references: [id], onDelete: SetNull)
  cash_recorder           User?                    @relation("SessionCashRecorder", fields: [cash_recorded_by], references: [id], onDelete: SetNull)

  @@unique([session_id, user_id])
  @@index([user_id, status])
  @@index([invited_by_user_id])
  @@index([cash_recorded_by])
  @@map("session_participants")
}

/// P3.1: a consent-based introduction to an expert (approved mentor). The
/// requester shares only a public summary of the context; nobody's phone or
/// email is ever returned. Accepting opens an in-app conversation and, if
/// the requester allowed it, gives the expert access to the idea.
model IntroductionRequest {
  id                  String                  @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  requester_user_id   String                  @db.Uuid
  target_user_id      String                  @db.Uuid
  context_type        IntroductionContextType
  /// The idea or business (null for a learning goal).
  context_id          String?                 @db.Uuid
  /// The public summary shared with the expert, frozen when sent.
  context_summary     String
  message             String
  status              IntroductionStatus      @default(PENDING)
  /// The requester (idea owner) lets the expert see the idea on accept.
  allow_idea_access   Boolean                 @default(false)
  idea_access_granted Boolean                 @default(false)
  conversation_id     String?                 @unique @db.Uuid
  expires_at          DateTime
  decided_at          DateTime?
  decline_reason      String?
  /// Set by moderation.
  hidden_at           DateTime?
  created_at          DateTime                @default(now())
  updated_at          DateTime                @updatedAt
  requester           User                    @relation("IntroductionRequester", fields: [requester_user_id], references: [id], onDelete: Cascade)
  target              User                    @relation("IntroductionTarget", fields: [target_user_id], references: [id], onDelete: Cascade)
  conversation        Conversation?           @relation(fields: [conversation_id], references: [id], onDelete: SetNull)
  sessions            Session[]
  community_groups    CommunityGroup[]

  @@index([requester_user_id, created_at(sort: Desc)])
  @@index([target_user_id, status])
  @@index([status, expires_at])
  @@map("introduction_requests")
}

/// P2.7: an idea. Private by default; at most a one-line summary is ever
/// public. Problem, solution and details are private details: only the
/// owner, the team and people the owner approved (idea_access) see them,
/// and every such view by someone else is logged (idea_detail_views).
model BusinessIdea {
  id                    String           @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  owner_user_id         String           @db.Uuid
  title                 String
  /// The one line anyone may see when the idea is SUMMARY_PUBLIC.
  summary               String
  problem               String
  solution              String
  details               String?
  category_id           String           @db.Uuid
  location_id           String?          @db.Uuid
  stage                 IdeaStage        @default(CONCEPT)
  visibility            IdeaVisibility   @default(PRIVATE)
  /// The owner allows AI analysis of the idea (no AI runs yet).
  ai_consent            Boolean          @default(false)
  converted_business_id String?          @unique @db.Uuid
  converted_at          DateTime?
  /// Set by moderation: hidden from everyone but the owner.
  hidden_at             DateTime?
  hidden_reason         String?
  deleted_at            DateTime?
  created_at            DateTime         @default(now())
  updated_at            DateTime         @updatedAt
  owner                 User             @relation("IdeaOwner", fields: [owner_user_id], references: [id], onDelete: Cascade)
  category              BusinessCategory @relation(fields: [category_id], references: [id], onDelete: Restrict)
  location              Location?        @relation(fields: [location_id], references: [id], onDelete: Restrict)
  converted_business    BusinessProfile? @relation(fields: [converted_business_id], references: [id], onDelete: SetNull)
  roles                 IdeaRole[]
  access                IdeaAccess[]
  members               IdeaMember[]
  detail_views          IdeaDetailView[]

  @@index([owner_user_id])
  @@index([visibility, stage, category_id, location_id])
  @@index([category_id])
  @@index([location_id])
  @@map("business_ideas")
}

/// P2.8: a role an idea seeks, with the skills, time and arrangement.
model IdeaRole {
  id                     String                 @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  idea_id                String                 @db.Uuid
  role_type              IdeaRoleType
  title                  String?
  description            String?
  time_commitment        IdeaTimeCommitment
  arrangement            IdeaArrangement        @default(UNDECIDED)
  status                 IdeaRoleStatus         @default(OPEN)
  sort_order             Int                    @default(0)
  /// Set by moderation.
  hidden_at              DateTime?
  created_at             DateTime               @default(now())
  updated_at             DateTime               @updatedAt
  idea                   BusinessIdea           @relation(fields: [idea_id], references: [id], onDelete: Cascade)
  skills                 IdeaRoleSkill[]
  members                IdeaMember[]
  collaboration_requests CollaborationRequest[]

  @@index([idea_id, status])
  @@map("idea_roles")
}

model IdeaRoleSkill {
  role_id  String   @db.Uuid
  skill_id String   @db.Uuid
  role     IdeaRole @relation(fields: [role_id], references: [id], onDelete: Cascade)
  skill    Skill    @relation(fields: [skill_id], references: [id], onDelete: Cascade)

  @@id([role_id, skill_id])
  @@index([skill_id])
  @@map("idea_role_skills")
}

/// P2.7: who may see an idea's private details. Requested with the
/// confidentiality notice accepted; the owner approves (stamped) or
/// declines, and can revoke at any time.
model IdeaAccess {
  id                          String           @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  idea_id                     String           @db.Uuid
  user_id                     String           @db.Uuid
  status                      IdeaAccessStatus @default(REQUESTED)
  message                     String?
  confidentiality_accepted_at DateTime
  approved_by_user_id         String?          @db.Uuid
  approved_at                 DateTime?
  decided_at                  DateTime?
  revoked_at                  DateTime?
  created_at                  DateTime         @default(now())
  updated_at                  DateTime         @updatedAt
  idea                        BusinessIdea     @relation(fields: [idea_id], references: [id], onDelete: Cascade)
  user                        User             @relation("IdeaAccessHolder", fields: [user_id], references: [id], onDelete: Cascade)
  approved_by                 User?            @relation("IdeaAccessApprover", fields: [approved_by_user_id], references: [id], onDelete: SetNull)

  @@unique([idea_id, user_id])
  @@index([user_id, status])
  @@index([approved_by_user_id])
  @@map("idea_access")
}

/// P2.7: every view of an idea's private details by someone other than the owner.
model IdeaDetailView {
  id             String       @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  idea_id        String       @db.Uuid
  viewer_user_id String       @db.Uuid
  /// Why they could see it: ACCESS (approved) or MEMBER (team).
  basis          String
  viewed_at      DateTime     @default(now())
  idea           BusinessIdea @relation(fields: [idea_id], references: [id], onDelete: Cascade)
  viewer         User         @relation("IdeaDetailViewer", fields: [viewer_user_id], references: [id], onDelete: Cascade)

  @@index([idea_id, viewed_at(sort: Desc)])
  @@index([viewer_user_id])
  @@map("idea_detail_views")
}

/// P2.9: the team, "agreed in principle" (not ownership, equity or a
/// legal partnership), usually from an AGREED collaboration request.
model IdeaMember {
  id                       String                @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  idea_id                  String                @db.Uuid
  user_id                  String                @db.Uuid
  role_id                  String?               @db.Uuid
  role_label               String?
  collaboration_request_id String?               @unique @db.Uuid
  agreed_in_principle_at   DateTime
  created_at               DateTime              @default(now())
  idea                     BusinessIdea          @relation(fields: [idea_id], references: [id], onDelete: Cascade)
  user                     User                  @relation("IdeaMembership", fields: [user_id], references: [id], onDelete: Cascade)
  role                     IdeaRole?             @relation(fields: [role_id], references: [id], onDelete: SetNull)
  collaboration_request    CollaborationRequest? @relation(fields: [collaboration_request_id], references: [id], onDelete: SetNull)

  @@unique([idea_id, user_id])
  @@index([user_id])
  @@index([role_id])
  @@map("idea_members")
}

/// P2.5: a proposal to work together on an idea or a business (plan
/// migrations 6 and 11). The recipient is the subject's owner when sent.
/// Connecting never creates ownership, equity or a legal partnership.
model CollaborationRequest {
  id                       String                      @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  requester_user_id        String                      @db.Uuid
  recipient_user_id        String                      @db.Uuid
  subject_type             CollaborationSubjectType
  subject_id               String                      @db.Uuid
  /// P2.8: "I'm interested in this role" (an idea_roles id; FK added with that table).
  idea_role_id             String?                     @db.Uuid
  /// The requester's own business, as context (optional).
  from_business_profile_id String?                     @db.Uuid
  message                  String
  status                   CollaborationStatus         @default(PROPOSED)
  conversation_id          String?                     @unique @db.Uuid
  agreement_summary        String?
  requester_agreed_at      DateTime?
  recipient_agreed_at      DateTime?
  decided_at               DateTime?
  agreed_at                DateTime?
  closed_at                DateTime?
  /// Set by moderation.
  hidden_at                DateTime?
  created_at               DateTime                    @default(now())
  updated_at               DateTime                    @updatedAt
  requester                User                        @relation("CollaborationRequester", fields: [requester_user_id], references: [id], onDelete: Cascade)
  recipient                User                        @relation("CollaborationRecipient", fields: [recipient_user_id], references: [id], onDelete: Cascade)
  from_business            BusinessProfile?            @relation(fields: [from_business_profile_id], references: [id], onDelete: SetNull)
  conversation             Conversation?               @relation(fields: [conversation_id], references: [id], onDelete: SetNull)
  events                   CollaborationRequestEvent[]
  idea_role                IdeaRole?                   @relation(fields: [idea_role_id], references: [id], onDelete: SetNull)
  idea_member              IdeaMember?

  @@index([requester_user_id, created_at(sort: Desc)])
  @@index([recipient_user_id, status])
  @@index([subject_type, subject_id])
  @@index([from_business_profile_id])
  @@map("collaboration_requests")
}

/// P2.5: the audit history of a collaboration request's status changes.
model CollaborationRequestEvent {
  id            String               @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  request_id    String               @db.Uuid
  actor_user_id String?              @db.Uuid
  from_status   CollaborationStatus?
  to_status     CollaborationStatus
  note          String?
  created_at    DateTime             @default(now())
  request       CollaborationRequest @relation(fields: [request_id], references: [id], onDelete: Cascade)
  actor         User?                @relation("CollaborationEventActor", fields: [actor_user_id], references: [id], onDelete: SetNull)

  @@index([request_id, created_at])
  @@index([actor_user_id])
  @@map("collaboration_request_events")
}

/// P2.1: who acts for a business. accepted_at null = invited, not yet a member.
model BusinessMember {
  id                  String             @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  business_profile_id String             @db.Uuid
  user_id             String             @db.Uuid
  role                BusinessMemberRole
  invited_by_user_id  String?            @db.Uuid
  accepted_at         DateTime?
  created_at          DateTime           @default(now())
  updated_at          DateTime           @updatedAt
  business            BusinessProfile    @relation(fields: [business_profile_id], references: [id], onDelete: Cascade)
  user                User               @relation("BusinessMembership", fields: [user_id], references: [id], onDelete: Cascade)
  invited_by          User?              @relation("BusinessMemberInviter", fields: [invited_by_user_id], references: [id], onDelete: SetNull)

  @@unique([business_profile_id, user_id])
  @@index([user_id])
  @@index([invited_by_user_id])
  @@map("business_members")
}

/// P2: the sector taxonomy for businesses and ideas (admin-configurable).
model BusinessCategory {
  id         String             @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  parent_id  String?            @db.Uuid
  slug       String             @unique
  name_en    String
  name_bn    String
  icon       String?
  sort_order Int                @default(0)
  is_active  Boolean            @default(true)
  created_at DateTime           @default(now())
  updated_at DateTime           @updatedAt
  parent     BusinessCategory?  @relation("BusinessCategoryTree", fields: [parent_id], references: [id], onDelete: Restrict)
  children   BusinessCategory[] @relation("BusinessCategoryTree")
  businesses BusinessProfile[]
  ideas      BusinessIdea[]

  @@index([parent_id])
  @@map("business_categories")
}

model Category {
  id                       String           @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  parent_id                String?          @db.Uuid
  slug                     String           @unique
  name_en                  String
  name_bn                  String
  icon                     String?
  sort_order               Int              @default(0)
  is_active                Boolean          @default(true)
  requires_manual_approval Boolean          @default(false)
  min_age                  Int              @default(18)
  requires_certificate     Boolean          @default(false)
  requires_identity        Boolean          @default(false)
  requires_poster_identity Boolean          @default(false)
  requires_references      Int              @default(0)
  requires_licence         Boolean          @default(false)
  safety_notice            String?
  unsafe_for_students      Boolean          @default(false)
  created_at               DateTime         @default(now())
  updated_at               DateTime         @updatedAt
  parent                   Category?        @relation("CategoryTree", fields: [parent_id], references: [id], onDelete: Restrict)
  children                 Category[]       @relation("CategoryTree")
  skills                   Skill[]
  primary_jobs             Job[]            @relation("JobCategory")
  subcategory_jobs         Job[]            @relation("JobSubcategory")
  portfolio_items          PortfolioItem[]
  communityGroups          CommunityGroup[]

  @@index([parent_id, sort_order])
  @@index([is_active, sort_order])
  @@map("categories")
}

model Skill {
  id                 String                @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  slug               String                @unique
  name_en            String
  name_bn            String
  category_id        String                @db.Uuid
  is_active          Boolean               @default(true)
  created_at         DateTime              @default(now())
  updated_at         DateTime              @updatedAt
  category           Category              @relation(fields: [category_id], references: [id], onDelete: Restrict)
  user_skills        UserSkill[]
  job_skills         JobSkill[]
  training_courses   TrainingCourse[]
  completion_records TrainingCertificate[]
  idea_role_skills   IdeaRoleSkill[]

  @@index([category_id, is_active])
  @@map("skills")
}

model UserSkill {
  user_id            String     @db.Uuid
  skill_id           String     @db.Uuid
  level              SkillLevel @default(BEGINNER)
  years              Decimal?   @db.Decimal(4, 1)
  is_verified        Boolean    @default(false)
  verified_at        DateTime?
  has_prior_training Boolean    @default(false)
  /// The person offers to teach this skill (approved mentors only).
  can_mentor         Boolean    @default(false)
  created_at         DateTime   @default(now())
  updated_at         DateTime   @updatedAt
  user               User       @relation(fields: [user_id], references: [id], onDelete: Cascade)
  skill              Skill      @relation(fields: [skill_id], references: [id], onDelete: Cascade)

  @@id([user_id, skill_id])
  @@index([skill_id, is_verified])
  @@map("user_skills")
}

model Location {
  id                String            @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  parent_id         String?           @db.Uuid
  type              LocationType
  name_en           String
  name_bn           String
  lat               Decimal?          @db.Decimal(9, 6)
  lng               Decimal?          @db.Decimal(9, 6)
  radius_km         Decimal?          @db.Decimal(6, 2)
  is_active         Boolean           @default(true)
  created_at        DateTime          @default(now())
  updated_at        DateTime          @updatedAt
  parent            Location?         @relation("LocationTree", fields: [parent_id], references: [id], onDelete: Restrict)
  children          Location[]        @relation("LocationTree")
  profiles          Profile[]
  business_profiles BusinessProfile[]
  business_ideas    BusinessIdea[]
  sessions          Session[]
  service_areas     ServiceArea[]
  jobs              Job[]
  communityGroups   CommunityGroup[]

  @@unique([parent_id, type, name_en])
  @@index([parent_id, type, is_active])
  @@map("locations")
}

model ServiceArea {
  id          String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  user_id     String   @db.Uuid
  location_id String   @db.Uuid
  radius_km   Decimal  @db.Decimal(6, 2)
  user        User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  location    Location @relation(fields: [location_id], references: [id], onDelete: Cascade)

  @@unique([user_id, location_id])
  @@index([location_id])
  @@map("service_areas")
}

model Job {
  id                      String             @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  poster_user_id          String             @db.Uuid
  title                   String
  description             String
  category_id             String             @db.Uuid
  subcategory_id          String?            @db.Uuid
  job_type                JobType
  payment_model           PaymentModel
  budget_min_poisha       BigInt?
  budget_max_poisha       BigInt?
  is_negotiable           Boolean            @default(false)
  currency                String             @default("BDT") @db.Char(3)
  location_id             String             @db.Uuid
  area_label              String?
  exact_address_encrypted String?
  lat                     Decimal?           @db.Decimal(9, 6)
  lng                     Decimal?           @db.Decimal(9, 6)
  starts_at               DateTime?
  ends_at                 DateTime?
  duration_minutes        Int?
  workers_required        Int                @default(1)
  workers_filled          Int                @default(0)
  experience_min_years    Int?
  urgency                 UrgencyLevel       @default(NORMAL)
  status                  JobStatus          @default(DRAFT)
  published_at            DateTime?
  expires_at              DateTime?
  filled_at               DateTime?
  completed_at            DateTime?
  applications_count      Int                @default(0)
  views_count             Int                @default(0)
  is_featured             Boolean            @default(false)
  recurrence_rule         Json?
  /// WORK = the paid-work marketplace (the default every work query uses).
  /// TRAINING / APPRENTICESHIP = a learning opportunity by an approved mentor.
  opportunity_type        OpportunityType    @default(WORK)
  /// Required for learning opportunities, empty for WORK.
  participant_terms       ParticipantTerms?
  /// What the participant pays (PAID_BY_PARTICIPANT only).
  participant_fee_poisha  BigInt?
  training_course_id      String?            @db.Uuid
  business_profile_id     String?            @db.Uuid
  work_arrangement        WorkArrangement    @default(ON_SITE)
  flexible_hours          Boolean            @default(false)
  parent_job_id           String?            @db.Uuid
  created_at              DateTime           @default(now())
  updated_at              DateTime           @updatedAt
  deleted_at              DateTime?
