  updated_at        DateTime         @updatedAt
  subject           User             @relation("RiskSubject", fields: [subject_user_id], references: [id], onDelete: Restrict)
  reviewer          User?            @relation("RiskReviewer", fields: [reviewer_user_id], references: [id], onDelete: SetNull)

  @@index([status, score(sort: Desc), created_at])
  @@index([subject_user_id, status])
  @@index([reviewer_user_id])
  @@map("risk_review_items")
}

model Badge {
