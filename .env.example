NODE_ENV=development
PORT=3000
API_BASE_URL=http://localhost:3000
# Reverse proxies in front of the API. 0 = use the socket address (local, no proxy).
# Render: set it explicitly in the dashboard (start with 1 and verify per
# docs/deploy-runbook.md "Trust proxy"). Production logs a warning when unset,
# because per-IP limits (OTP 20/hour) would otherwise be shared by everyone.
TRUST_PROXY_HOPS=0
# Background runners. Set false on every API instance except one when scaling out.
RUN_SCHEDULERS=true

POSTGRES_DB=kaj
POSTGRES_USER=kaj
POSTGRES_PASSWORD=kaj_local_only
POSTGRES_PORT=5432
DATABASE_URL=postgresql://kaj:kaj_local_only@localhost:5432/kaj

REDIS_PORT=6379
REDIS_URL=redis://localhost:6379
# true when several API instances serve the chat socket (shares rooms via Redis)
SOCKET_REDIS_ADAPTER=false

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
ADMIN_SESSION_SECRET=
ADMIN_TOTP_ENCRYPTION_KEY=
# LOCAL DEVELOPMENT ONLY. The dev seed refuses these example values unless the
# database is on this machine, and creates no admin when they are unset. Never
# use them for a hosted environment (see docs/deploy-runbook.md).
ADMIN_SEED_EMAIL=admin@kaj.local
ADMIN_SEED_PASSWORD=KajAdminLocal123!
ADMIN_SEED_TOTP_SECRET=JBSWY3DPEHPK3PXP

OTP_TTL_SECONDS=300
OTP_FIXED_CODE=
OTP_HASH_SECRET=
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
# Use bdapps only after the Kaaj application hash, billing disclosure, and
# whitelisted test number have been confirmed. Secrets stay server-side.
SMS_PROVIDER=console
OPERATOR_PROVIDER=pending
BDAPPS_GATEWAY_URL=
BDAPPS_INTERNAL_API_KEY=
PUSH_PROVIDER=disabled

MINIO_ROOT_USER=kaj_minio
MINIO_ROOT_PASSWORD=kaj_minio_local_only
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=kaj-local
S3_KEY=kaj_minio
S3_SECRET=kaj_minio_local_only
S3_REGION=ap-south-1
STORAGE_PROVIDER=s3

MAILHOG_SMTP_PORT=1025
MAILHOG_HTTP_PORT=8025

FCM_SERVICE_ACCOUNT_JSON_PATH=
SENTRY_DSN=
PAYMENT_PROVIDER=manual
PLATFORM_FEE_DEFAULT_BPS=800
DEFAULT_TIMEZONE=Asia/Dhaka
DEFAULT_LOCALE=bn

# P4 AI Opportunity Intelligence (off by default). Put ANTHROPIC_API_KEY only
# in the host's secret env, never in a file in the repo.
AI_ENABLED=false
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5
AI_TIMEOUT_MS=60000
AI_MAX_RETRIES=2
AI_DAILY_LIMIT_IDEA_ANALYSIS=3
AI_DAILY_LIMIT_SUGGESTIONS=10
AI_DAILY_LIMIT_GROWTH_TIPS=5
AI_GLOBAL_DAILY_LIMIT=2000

# Launch content (`pnpm seed:launch`, run on purpose only; see
# docs/deploy-runbook.md, "Launch content"). The admin account that owns it
# (else ADMIN_SEED_EMAIL, else the only admin) and its display name.
LAUNCH_OWNER_EMAIL=
LAUNCH_OWNER_NAME=
# A verified woman to moderate the women-only group; without it that group is held.
LAUNCH_WOMEN_MODERATOR_PHONE=
