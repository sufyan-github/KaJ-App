# Server-side gateway configuration only.
# Copy this file to .env on the private gateway host and replace every value.
# Never pass any of these values to Flutter or commit the populated .env file.
BDAPPS_APP_ID=APP_REPLACE_ME
BDAPPS_PASSWORD=replace-on-server
BDAPPS_APP_HASH=replace-on-server
INTERNAL_API_KEY=replace-with-a-long-random-server-key
NODE_BACKEND_URL=https://api.example.com
NODE_BACKEND_WEBHOOK_PATH=/api/v1/bdapps/events
