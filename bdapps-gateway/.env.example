# KAAJ BDApps gateway configuration.
# Copy to ../kaaj-bdapps-gateway.env (preferred: outside public_html) or to
# .env in this folder, then fill in real values. Never commit the real file.

# BDApps application credentials (developer.bdapps.com > My Apps).
BDAPPS_APP_ID=APP_000000
BDAPPS_PASSWORD=replace-with-bdapps-api-password
BDAPPS_APP_HASH=replace-with-kaaj-application-hash
# Android package name (or Play Store URL) sent as applicationMetaData.appCode.
BDAPPS_APP_CODE=app.kaaj.mobile
# Optional: sender/short code for /sms/send (leave empty to use the app default).
BDAPPS_SMS_SOURCE_ADDRESS=
# Only change for local testing against dev/mock-bdapps.mjs.
BDAPPS_API_BASE=https://developer.bdapps.com

# Shared HMAC key (32+ random characters). Must equal BDAPPS_INTERNAL_API_KEY
# in the Nest API. Generate with: openssl rand -hex 32
INTERNAL_API_KEY=replace-with-64-hex-characters

# Nest API base URL, no trailing slash, and the webhook path.
NODE_BACKEND_URL=https://api.example.com
NODE_BACKEND_WEBHOOK_PATH=/api/v1/subscriptions/bdapps/webhook

# Runtime state (nonces, notification dedupe, logs). Prefer a folder outside
# the public document root, e.g. /home/<cpanel-user>/kaaj-gateway-storage
GATEWAY_STORAGE_DIR=
GATEWAY_LOG_FILE=
# Minimum seconds between forwarded notifications per subscriber (default 10).
CALLBACK_THROTTLE_SECONDS=10
